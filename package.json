{
  "name": "orda-web",
  "version": "0.1.0",
  "private": true,
  "description": "Официальный сайт ФК «Ордабасы» (ORDA)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "format": "prettier --write \"src/**/*.{tsx,ts,js,css}\"",
    "typecheck": "tsc --noEmit",
    "preview:artifact": "node tools/artifact-preview/build.mjs && cp -r public/img public/fonts preview-artifact/"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
